
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------
    // COMMON SECURITY HELPERS
    // -----------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function userMembershipPath(uid, orgId) {
      return /databases/$(database)/documents/users/$(uid)/memberships/$(orgId);
    }

    function wastePath(orgId, wasteId) {
      return /databases/$(database)/documents/organizations/$(orgId)/wasteRecords/$(wasteId);
    }

    function processorPath(orgId, processorId) {
      return /databases/$(database)/documents/organizations/$(orgId)/processors/$(processorId);
    }

    function collectionPath(orgId, collectionId) {
      return /databases/$(database)/documents/organizations/$(orgId)/collections/$(collectionId);
    }

    function certificatePath(orgId, certificateId) {
      return /databases/$(database)/documents/organizations/$(orgId)/certificates/$(certificateId);
    }

    function certificateIndexPath(orgId, indexId) {
      return /databases/$(database)/documents/organizations/$(orgId)/certificateIndexes/$(indexId);
    }

    function isMember(orgId) {
      return signedIn()
        && exists(memberPath(orgId, request.auth.uid));
    }

    function isAdmin(orgId) {
      return isMember(orgId)
        && get(memberPath(orgId, request.auth.uid)).data.role == "admin";
    }

    function validWasteType(value) {
      return value in ["Wet Waste", "Dry Waste"];
    }

    // -----------------------------------------
    // ORGANISATIONS
    // -----------------------------------------

    match /organizations/{orgId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name", "createdBy", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "name", "createdBy", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && existsAfter(memberPath(orgId, request.auth.uid))
        && existsAfter(userMembershipPath(request.auth.uid, orgId))
        && getAfter(memberPath(orgId, request.auth.uid)).data.role == "admin"
        && getAfter(userMembershipPath(request.auth.uid, orgId)).data.role == "admin";

      allow read: if isMember(orgId);

      allow update: if isAdmin(orgId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["name"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow delete: if false;

      // ---------------------------------------
      // ORGANISATION MEMBERS
      // ---------------------------------------

      match /members/{memberUid} {

        allow create: if signedIn()
          && request.auth.uid == memberUid
          && existsAfter(orgPath(orgId))
          && getAfter(orgPath(orgId)).data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "uid", "email", "role", "joinedAt"
          ])
          && request.resource.data.keys().hasAll([
            "uid", "email", "role", "joinedAt"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.role == "admin"
          && request.resource.data.joinedAt is timestamp
          && getAfter(userMembershipPath(request.auth.uid, orgId)).data.role == "admin";

        allow read: if isMember(orgId);

        allow update, delete: if false;
      }

      // ---------------------------------------
      // WASTE RECORDS
      // ---------------------------------------

      match /wasteRecords/{wasteId} {

        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasOnly([
            "date",
            "type",
            "amount",
            "collectedAmount",
            "status",
            "notes",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "date",
            "type",
            "amount",
            "collectedAmount",
            "status",
            "notes",
            "createdAt"
          ])
          && request.resource.data.date is string
          && validWasteType(request.resource.data.type)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.collectedAmount == 0
          && request.resource.data.status == "Pending"
          && request.resource.data.notes is string
          && request.resource.data.createdAt is timestamp;

        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "collectedAmount",
              "status",
              "lastCollectionId"
            ])
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.date == resource.data.date
          && request.resource.data.type == resource.data.type
          && request.resource.data.notes == resource.data.notes
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.collectedAmount is number
          && request.resource.data.collectedAmount > resource.data.collectedAmount
          && request.resource.data.collectedAmount <= resource.data.amount
          && request.resource.data.lastCollectionId is string
          && request.resource.data.status ==
            (request.resource.data.collectedAmount == request.resource.data.amount
              ? "Collected"
              : "Partial")
          && existsAfter(collectionPath(
            orgId,
            request.resource.data.lastCollectionId
          ))
          && getAfter(collectionPath(
            orgId,
            request.resource.data.lastCollectionId
          )).data.wasteRecordId == wasteId
          && getAfter(collectionPath(
            orgId,
            request.resource.data.lastCollectionId
          )).data.amount ==
            request.resource.data.collectedAmount - resource.data.collectedAmount;

        allow delete: if false;
      }

      // ---------------------------------------
      // PROCESSORS
      // ---------------------------------------

      match /processors/{processorId} {

        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasOnly([
            "name",
            "contact",
            "phone",
            "address",
            "method",
            "acceptedWaste",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "name",
            "contact",
            "phone",
            "address",
            "method",
            "acceptedWaste",
            "createdAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.contact is string
          && request.resource.data.phone is string
          && request.resource.data.address is string
          && request.resource.data.method is string
          && request.resource.data.acceptedWaste is list
          && request.resource.data.acceptedWaste.size() > 0
          && request.resource.data.acceptedWaste.hasOnly([
            "Wet Waste",
            "Dry Waste"
          ])
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }

      // ---------------------------------------
      // COLLECTIONS / PICKUP RECORDS
      // ---------------------------------------

      match /collections/{collectionId} {

        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasOnly([
            "wasteRecordId",
            "wasteDate",
            "wasteType",
            "date",
            "amount",
            "collector",
            "reference",
            "processorId",
            "processorName",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "wasteRecordId",
            "wasteDate",
            "wasteType",
            "date",
            "amount",
            "collector",
            "reference",
            "processorId",
            "processorName",
            "createdAt"
          ])
          && request.resource.data.wasteRecordId is string
          && request.resource.data.wasteDate is string
          && validWasteType(request.resource.data.wasteType)
          && request.resource.data.date is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.collector is string
          && request.resource.data.reference is string
          && request.resource.data.processorId is string
          && request.resource.data.processorName is string
          && request.resource.data.createdAt is timestamp
          && exists(wastePath(orgId, request.resource.data.wasteRecordId))
          && exists(processorPath(orgId, request.resource.data.processorId))
          && get(wastePath(
            orgId,
            request.resource.data.wasteRecordId
          )).data.type == request.resource.data.wasteType
          && get(wastePath(
            orgId,
            request.resource.data.wasteRecordId
          )).data.date == request.resource.data.wasteDate
          && get(processorPath(
            orgId,
            request.resource.data.processorId
          )).data.name == request.resource.data.processorName
          && get(processorPath(
            orgId,
            request.resource.data.processorId
          )).data.acceptedWaste.hasAny([
            request.resource.data.wasteType
          ])
          && existsAfter(wastePath(
            orgId,
            request.resource.data.wasteRecordId
          ))
          && getAfter(wastePath(
            orgId,
            request.resource.data.wasteRecordId
          )).data.lastCollectionId == collectionId
          && getAfter(wastePath(
            orgId,
            request.resource.data.wasteRecordId
          )).data.collectedAmount ==
            get(wastePath(
              orgId,
              request.resource.data.wasteRecordId
            )).data.collectedAmount + request.resource.data.amount;

        allow update, delete: if false;
      }

      // ---------------------------------------
      // CERTIFICATES
      // ---------------------------------------

      match /certificates/{certificateId} {

        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasOnly([
            "certificateNumber",
            "certificateNumberLower",
            "certificateIndexId",
            "issuer",
            "issueDate",
            "complianceYear",
            "quantity",
            "reference",
            "notes",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "certificateNumber",
            "certificateNumberLower",
            "certificateIndexId",
            "issuer",
            "issueDate",
            "complianceYear",
            "quantity",
            "reference",
            "notes",
            "createdAt"
          ])
          && request.resource.data.certificateNumber is string
          && request.resource.data.certificateNumber.size() > 0
          && request.resource.data.certificateNumberLower is string
          && request.resource.data.certificateNumberLower ==
            request.resource.data.certificateNumber.lower()
          && request.resource.data.certificateIndexId is string
          && request.resource.data.certificateIndexId.size() == 64
          && request.resource.data.issuer is string
          && request.resource.data.issuer.size() > 0
          && request.resource.data.issueDate is string
          && request.resource.data.complianceYear is int
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.reference is string
          && request.resource.data.notes is string
          && request.resource.data.createdAt is timestamp
          && existsAfter(certificateIndexPath(
            orgId,
            request.resource.data.certificateIndexId
          ))
          && getAfter(certificateIndexPath(
            orgId,
            request.resource.data.certificateIndexId
          )).data.certificateId == certificateId
          && getAfter(certificateIndexPath(
            orgId,
            request.resource.data.certificateIndexId
          )).data.certificateNumberLower ==
            request.resource.data.certificateNumberLower;

        allow update, delete: if false;
      }

      // ---------------------------------------
      // CERTIFICATE UNIQUE INDEXES
      // ---------------------------------------

      match /certificateIndexes/{indexId} {

        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasOnly([
            "certificateId",
            "certificateNumberLower",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "certificateId",
            "certificateNumberLower",
            "createdAt"
          ])
          && request.resource.data.certificateId is string
          && request.resource.data.certificateNumberLower is string
          && request.resource.data.certificateNumberLower.size() > 0
          && request.resource.data.createdAt is timestamp
          && existsAfter(certificatePath(
            orgId,
            request.resource.data.certificateId
          ))
          && getAfter(certificatePath(
            orgId,
            request.resource.data.certificateId
          )).data.certificateIndexId == indexId
          && getAfter(certificatePath(
            orgId,
            request.resource.data.certificateId
          )).data.certificateNumberLower ==
            request.resource.data.certificateNumberLower;

        allow update, delete: if false;
      }
    }

    // -----------------------------------------
    // USER MEMBERSHIPS
    // -----------------------------------------

    match /users/{userId}/memberships/{orgId} {

      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && existsAfter(orgPath(orgId))
        && getAfter(orgPath(orgId)).data.createdBy == request.auth.uid
        && existsAfter(memberPath(orgId, userId))
        && getAfter(memberPath(orgId, userId)).data.role == "admin"
        && request.resource.data.keys().hasOnly([
          "organizationId",
          "organizationName",
          "role",
          "joinedAt"
        ])
        && request.resource.data.keys().hasAll([
          "organizationId",
          "organizationName",
          "role",
          "joinedAt"
        ])
        && request.resource.data.organizationId == orgId
        && request.resource.data.organizationName is string
        && request.resource.data.role == "admin"
        && request.resource.data.joinedAt is timestamp;

      allow update, delete: if false;
    }
  }
}
